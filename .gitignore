# =============================================
# Root .gitignore for Monorepo
# Covers: Document_Assisstant & FinsightsAI
# =============================================

# Environment variables (NEVER commit API keys!)
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Data files (large / generated)
*.csv
*.parquet
*.pkl
*.json
data/raw/
data/processed/
data/models/

# Logs
*.log
logs/

# IDE / editor
.vscode/
.idea/
*.suo
*.user

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Kaggle credentials
kaggle.json

# Model outputs / SHAP
*.png
*.html
shap_values/
